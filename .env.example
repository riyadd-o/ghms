# ==============================================================================
# Golden Hotel Management System (GHMS) - Environment Variables Template
# Copy this file to .env.local and populate the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string to your PostgreSQL instance (e.g. Neon serverless pooler)
# Format: postgresql://<user>:<password>@<ep-identifier>.pooler.<region>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/golden_hotel?sslmode=require

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Strong secret key used by jose to sign and verify staff JWT session tokens
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Shared secret key for securing scheduled cron endpoints (e.g. /api/cron/keep-warm)
CRON_SECRET=your_secure_cron_secret_token

# ------------------------------------------------------------------------------
# 3. PUBLIC APP CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL for redirects, tracking links in emails, and payment callback URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Fixed home delivery fee in ETB (defaults to 100 ETB if not provided)
NEXT_PUBLIC_DELIVERY_FEE=100
DEFAULT_DELIVERY_FEE=100

# Active digital payment provider: "CHAPA" | "BIRRPAY" (default: "CHAPA")
ACTIVE_PAYMENT_PROVIDER=CHAPA

# ------------------------------------------------------------------------------
# 4. CHAPA PAYMENT GATEWAY (Ethiopian Birr / ETB)
# ------------------------------------------------------------------------------
# Secret and public API keys from your Chapa merchant dashboard (https://chapa.co)
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_BASE_URL=https://api.chapa.co

# Secret key or webhook hash configured in Chapa to verify incoming webhooks
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_key

# ------------------------------------------------------------------------------
# 5. CLOUDINARY MEDIA STORAGE & CDN
# ------------------------------------------------------------------------------
# Credentials from your Cloudinary dashboard (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAILS (Nodemailer / Gmail SMTP)
# ------------------------------------------------------------------------------
# Sender email account and dedicated 16-character Google App Password
# (Google Account -> Security -> 2-Step Verification -> App Passwords)
GMAIL_USER=your-hotel-notification@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
